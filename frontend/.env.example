# Copia este archivo como .env.local y completa los valores.

# URL de tu WordPress con WooCommerce (sin / al final)
WC_STORE_URL=https://admin.tutienda.com

# sandbox mientras pruebas, production cuando salgas en vivo.
# Debe coincidir con las llaves configuradas en la pasarela de WordPress.
WOMPI_ENV=sandbox

# Secreto compartido con WordPress para refrescar el catálogo al editar productos.
# Pon el mismo valor en WooCommerce > Ajustes > Pagos > Wompi (headless).
REVALIDATE_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio
