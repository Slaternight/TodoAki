# Variables para el WordPress local en Docker (docker compose + docker/setup.sh).
# Copia este archivo como .env

WP_URL=http://localhost:8080
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=
WP_ADMIN_EMAIL=admin@tienda.test

# URL de Next.js que ve el navegador (Wompi devuelve al cliente aquí)
FRONTEND_URL=http://localhost:3000
# Mismo valor que REVALIDATE_SECRET en frontend/.env.local
REVALIDATE_SECRET=

# Llaves de SANDBOX de Wompi (comercios.wompi.co > Desarrolladores)
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Importación del catálogo desde tu tienda Shopify (solo servidor; nunca en el front)
SHOPIFY_STORE=
SHOPIFY_TOKEN=
IMPORT_IMAGES=1
